<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/vg_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/vg_primary" app:cardCornerRadius="24dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VIDEOGRAB 5" android:textColor="@color/vg_on_primary" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Your downloads, one place." android:textColor="@color/vg_on_primary" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Browse, detect, choose quality, convert audio, and manage everything without leaving the app." android:textColor="@color/vg_on_primary" android:alpha="0.86" android:textSize="14sp" android:lineSpacingExtra="2dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/home_browse" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Open browser" android:textAllCaps="false" android:textColor="@color/vg_primary" app:backgroundTint="@color/vg_on_primary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/home_paste" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Paste link" android:textAllCaps="false" android:textColor="@color/vg_on_primary" app:strokeColor="@color/vg_on_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="Overview" android:textColor="@color/vg_text" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" app:cardBackgroundColor="@color/vg_surface" app:cardCornerRadius="18dp" app:strokeColor="@color/vg_outline" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/home_active_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/vg_primary" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Active" android:textColor="@color/vg_text_muted" android:textSize="13sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" app:cardBackgroundColor="@color/vg_surface" app:cardCornerRadius="18dp" app:strokeColor="@color/vg_outline" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/home_done_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/vg_success" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Finished" android:textColor="@color/vg_text_muted" android:textSize="13sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" app:cardBackgroundColor="@color/vg_surface" app:cardCornerRadius="18dp" app:strokeColor="@color/vg_outline" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/home_library_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/vg_secondary" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Library" android:textColor="@color/vg_text_muted" android:textSize="13sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/vg_surface" app:cardCornerRadius="18dp" app:strokeColor="@color/vg_outline" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Smart detection" android:textColor="@color/vg_text" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/home_smart_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Filtering small/ad-like media" android:textColor="@color/vg_text_muted" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:text="Recent activity" android:textColor="@color/vg_text" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/home_recent_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="10dp" android:text="Supported workflow" android:textColor="@color/vg_text" android:textSize="18sp" android:textStyle="bold" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="6dp">
            <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Direct video" />
            <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HLS qualities" />
            <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DASH + merge" />
            <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MP3 export" />
        </com.google.android.material.chip.ChipGroup>
        <Space android:layout_width="1dp" android:layout_height="18dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
