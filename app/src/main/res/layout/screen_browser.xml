<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/vg_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="12dp" android:layout_marginTop="10dp" android:layout_marginEnd="12dp" android:layout_marginBottom="6dp" app:cardBackgroundColor="@color/vg_surface" app:cardCornerRadius="18dp" app:cardElevation="1dp" app:strokeColor="@color/vg_outline" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/browser_back" style="@style/Widget.Material3.Button.IconButton" android:layout_width="44dp" android:layout_height="44dp" app:icon="@drawable/ic_back" />
                <com.google.android.material.button.MaterialButton android:id="@+id/browser_forward" style="@style/Widget.Material3.Button.IconButton" android:layout_width="44dp" android:layout_height="44dp" app:icon="@drawable/ic_forward" />
                <com.google.android.material.button.MaterialButton android:id="@+id/browser_reload" style="@style/Widget.Material3.Button.IconButton" android:layout_width="44dp" android:layout_height="44dp" app:icon="@drawable/ic_refresh" />
                <EditText android:id="@+id/browser_address" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Search or enter website" android:imeOptions="actionGo" android:inputType="textUri" android:paddingStart="8dp" android:paddingEnd="8dp" android:singleLine="true" android:textColor="@color/vg_text" android:textColorHint="@color/vg_text_muted" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/browser_go" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="44dp" android:layout_height="44dp" app:icon="@drawable/ic_go" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/browser_status" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Ready • Smart detection on" android:textColor="@color/vg_text_muted" android:textSize="12sp" />
        <ProgressBar android:id="@+id/browser_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:max="100" />
        <WebView android:id="@+id/browser_webview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/vg_surface" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/detect_fab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="18dp" android:text="Detect media" android:textAllCaps="false" app:icon="@drawable/ic_detect" app:iconTint="@color/vg_on_primary" app:backgroundTint="@color/vg_primary" app:iconPadding="8dp" android:textColor="@color/vg_on_primary" />
</FrameLayout>
